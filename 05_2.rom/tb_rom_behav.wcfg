<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="tb_rom_behav.wdb" id="1">
         <top_modules>
            <top_module name="glbl" />
            <top_module name="tb_rom" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="0fs"></ZoomStartTime>
      <ZoomEndTime time="400001fs"></ZoomEndTime>
      <Cursor1Time time="400000fs"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="216"></NameColumnWidth>
      <ValueColumnWidth column_width="100"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="3" />
   <wvobject fp_name="/tb_rom/addr" type="array">
      <obj_property name="ElementShortName">addr[3:0]</obj_property>
      <obj_property name="ObjectShortName">addr[3:0]</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_rom/oe" type="logic">
      <obj_property name="ElementShortName">oe</obj_property>
      <obj_property name="ObjectShortName">oe</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_rom/data_out" type="array">
      <obj_property name="ElementShortName">data_out[7:0]</obj_property>
      <obj_property name="ObjectShortName">data_out[7:0]</obj_property>
      <obj_property name="Radix">HEXRADIX</obj_property>
   </wvobject>
</wave_config>
